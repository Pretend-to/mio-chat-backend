{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "style": "warn",
    "pedantic": "off",
    "nursery": "off",
    "restriction": "off"
  },
  "rules": {
    "no-underscore-dangle": "off",
    "consistent-function-scoping": "off",
    "no-shadow": [
      "error",
      {
        "allow": [
          "err",
          "error",
          "e",
          "data",
          "result",
          "config",
          "client",
          "adapter",
          "t",
          "cb",
          "callback",
          "url",
          "options",
          "code",
          "msg"
        ]
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "globals": {
    "middleware": "readonly",
    "logger": "readonly"
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "output/**",
    "logs/**",
    ".git/**",
    "docs/**",
    "web-articles/**",
    "pdf_report/**",
    "scratch/**",
    "projects/**",
    "**/*.min.js",
    "**/*.bundle.js"
  ]
}