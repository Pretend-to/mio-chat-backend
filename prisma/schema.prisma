// Prisma schema file for Mio-Chat SQLite migration

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

// 预设表
model Preset {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  type        String   @default("custom") // 'built-in' | 'custom'
  category    String   @default("common") // 'common' | 'recommended' | 'hidden'
  history     String // JSON 格式存储对话历史
  opening     String   @default("")
  tools       String   @default("[]") // JSON 格式存储工具列表
  provider    String   @default("") // LLM 渠道名（displayName），空则使用系统默认
  model       String   @default("") // 模型名，空则使用渠道默认
  recommended Boolean  @default(false)
  hidden      Boolean  @default(false)
  avatar      String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([type])
  @@index([category])
  @@map("presets")
}

// 插件配置表
model PluginConfig {
  id         Int      @id @default(autoincrement())
  pluginName String   @unique @map("plugin_name")
  configData String   @map("config_data") // JSON 格式存储配置
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([pluginName])
  @@index([enabled])
  @@map("plugin_configs")
}

// 系统配置表
model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String // JSON 格式存储复杂配置
  category    String   @default("general") // 'general' | 'server' | 'web' | 'onebot' | 'llm'
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@index([category])
  @@map("system_settings")
}

// LLM适配器配置表
model LLMAdapter {
  id           Int      @id @default(autoincrement())
  adapterType  String   @map("adapter_type") // 'openai' | 'gemini' | 'vertex' | 'deepseek'
  instanceName String   @map("instance_name") // 实例名称，同类型可有多个实例
  configData   String   @map("config_data") // JSON 格式存储适配器配置
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([adapterType, instanceName])
  @@index([adapterType])
  @@index([enabled])
  @@map("llm_adapters")
}

// 模型所有者配置表
model ModelOwner {
  id        Int      @id @default(autoincrement())
  owner     String
  keywords  String // JSON 数组格式存储关键词
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([owner])
  @@map("model_owners")
}

// 日志配置表
model LogConfig {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  bufferSize    Int      @default(1000) @map("buffer_size")
  flushInterval Int      @default(1000) @map("flush_interval")
  sources       String   @default("[]") // JSON 格式存储日志源
  filters       String   @default("{}") // JSON 格式存储过滤器
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("log_configs")
}

// 日志统计表
model LogStat {
  id        Int      @id @default(autoincrement())
  date      DateTime
  level     String
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([date, level])
  @@index([date])
  @@index([level])
  @@map("log_stats")
}

// 定时任务表
model Task {
  id                String    @id
  name              String?
  cron              String
  runAt             DateTime? @map("run_at")
  agentId           String    @map("agent_id")
  sessionId         String    @map("session_id")
  deliveryBindingId String?   @map("delivery_binding_id")
  deliveryMode      String    @default("default") @map("delivery_mode")
  triggerPrompt     String?   @default("") @map("prompt")
  status            String    @default("active")
  lastRunAt         DateTime? @map("last_run_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  agent           Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  session         Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  deliveryBinding AgentChannelBinding? @relation(fields: [deliveryBindingId], references: [id], onDelete: SetNull)
  executions      TaskExecution[]

  @@index([agentId, status])
  @@index([sessionId])
  @@index([deliveryBindingId])
  @@map("tasks")
}

// 任务执行记录表（每次定时触发对应一条）
model TaskExecution {
  id                Int       @id @default(autoincrement())
  taskId            String    @map("task_id")
  // Scalar audit link: adding a FK here would rebuild this populated SQLite table.
  sessionWorkItemId String?   @map("session_work_item_id")
  round             Int       @default(1)
  agentId           String    @map("agent_id")
  sessionId         String    @map("session_id")
  deliveryBindingId String?   @map("delivery_binding_id")
  triggerPrompt     String?   @map("trigger_prompt")
  inputMessages     String    @map("input_messages") // JSON: 发送给 LLM 的完整 messages 数组
  outputChunks      String    @default("[]") @map("output_chunks") // JSON: 原始 streamCache chunks 全量
  finalAssistantMsg String?   @map("final_assistant_msg") // JSON: 组装后的 assistant 消息
  status            String    @default("running") // running | completed | failed
  deliveryStatus    String    @default("not_requested") @map("delivery_status")
  deliveryError     String?   @map("delivery_error")
  synced            Boolean   @default(false) // 是否已推送到前端
  startedAt         DateTime  @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  errorMessage      String?   @map("error_message")

  task            Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, round])
  @@index([agentId, sessionId])
  @@index([sessionWorkItemId])
  @@index([status])
  @@map("task_executions")
}

// LLM 调用审计日志表
model LLMCallLog {
  id                Int      @id @default(autoincrement())
  requestId         String   @map("request_id") // 关联事件请求 ID (e.requestId)
  userId            String?  @map("user_id") // 触发调用的用户 ID (e.user?.id)
  userIp            String?  @map("user_ip") // 触发调用的 IP 地址 (e.user?.ip)
  contactorId       String?  @map("contactor_id") // 触发会话的窗口 ID (e.body?.contactorId)
  sourceType        String?  @map("source_type") // 调用来源: web | channel | system
  sessionId         String?  @map("session_id") // 关联 Session.id，不使用 preset 作为会话标识
  channelId         String?  @map("channel_id") // 关联 Channel.id
  presetName        String?  @map("preset_name") // 使用的 Agent 预设名称 (e.body?.settings?.presetSettings?.name)
  sessionTitle      String?  @map("session_title") // 关联会话的主题/第一条输入
  provider          String // 历史适配器类型标签，保留用于兼容旧审计数据
  adapterInstanceId String?  @map("adapter_instance_id") // 实际调用的适配器实例 ID
  adapterName       String?  @map("adapter_name") // 用户配置的适配器实例显示名称
  adapterType       String?  @map("adapter_type") // 适配器实现类型 (openai, vertex 等)
  model             String // 调用的具体模型 (如 deepseek-chat, gpt-5.4-nano 等)
  isStream          Boolean  @default(true) @map("is_stream") // 是否流式请求
  trafficType       String?  @map("traffic_type") // 计费流量类型 (如 Gemini: ON_DEMAND)
  promptTokens      Int      @default(0) @map("prompt_tokens") // 输入 Token 数
  candidatesTokens  Int      @default(0) @map("candidates_tokens") // 输出 Token 数
  thinkingTokens    Int      @default(0) @map("thinking_tokens") // 深度思考 Token 数
  toolsCalled       String?  @default("[]") @map("tools_called") // JSON 数组，记录调用的多个工具名称 (如 ["memory_query", "web_search"])
  toolDetails       String?  @default("[]") @map("tool_details") // JSON 数组，记录调用的多个工具详细信息 { name, arguments, output }
  cacheHitTokens    Int      @default(0) @map("cache_hit_tokens") // 缓存命中 Token 数
  cacheMissTokens   Int      @default(0) @map("cache_miss_tokens") // 缓存未命中 Token 数
  totalTokens       Int      @default(0) @map("total_tokens") // 总 Token 数
  latency           Int // 总耗时/延迟 (单位: ms)
  ttft              Int? // 首字延迟 (Time-To-First-Token, 单位: ms)，非流式则为 null
  tps               Float? // 端到端输出吞吐 (candidates tokens / request latency seconds)
  status            String   @default("SUCCESS") // 状态: SUCCESS (成功) | FAILED (异常失败) | ABORTED (用户中止)
  errorMessage      String?  @map("error_message") // 失败异常时的错误堆栈/原因
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([requestId])
  @@index([requestId, id])
  @@index([userId])
  @@index([userIp])
  @@index([contactorId])
  @@index([sourceType])
  @@index([sessionId])
  @@index([channelId])
  @@index([provider])
  @@index([adapterInstanceId])
  @@index([adapterName])
  @@index([model])
  @@index([status])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([createdAt, status])
  @@map("llm_call_logs")
}

// 生图适配器配置表
model ImageAdapter {
  id           Int      @id @default(autoincrement())
  adapterType  String   @map("adapter_type") // 'openai' | 'gemini' | 'volcengine' | 'sd-webui' | 'ttd'
  instanceName String   @map("instance_name")
  configData   String   @map("config_data") // JSON 格式存储配置
  enabled      Boolean  @default(true)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([adapterType, instanceName])
  @@index([adapterType])
  @@index([enabled])
  @@map("image_adapters")
}

// 搜索适配器配置表
model SearchAdapter {
  id           Int      @id @default(autoincrement())
  adapterType  String   @map("adapter_type") // 'tavily' | 'duckduckgo' | 'bing' | 'google' | 'searxng' | 'zhipu'
  instanceName String   @map("instance_name")
  configData   String   @map("config_data") // JSON 格式存储配置
  enabled      Boolean  @default(true)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([adapterType, instanceName])
  @@index([adapterType])
  @@index([enabled])
  @@map("search_adapters")
}

// Shell 自动审批规则表（后端权威名单，替代前端 localStorage 名单）
// allow=白名单放行 / deny=高危黑名单必须人工介入；cwd 可选：目录前缀绑定（null=全局生效）
model ShellAutoApproveRule {
  id           Int      @id @default(autoincrement())
  matchType    String   @map("match_type") // 'command' 全等 | 'prefix' 前缀
  match        String
  cwd          String? // 可选工作区目录前缀，null=全局
  deny         Boolean  @default(false) // false=放行, true=高危黑名单(deny)
  rememberable Boolean  @default(false) // deny 高危细分：false=绝对危险(禁记住/强制人工), true=一般高危(可记住/限工作区)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([enabled])
  @@map("shell_auto_approve_rules")
}

// Agent, Session and Channel models. Breaking reset policy is documented in
// docs/architecture/channel-agent-refactor/Spec.md.
model Agent {
  id                       String   @id
  name                     String   @default("Agent")
  avatar                   String?
  description              String?
  soul                     String?
  defaultSessionId         String?  @map("default_session_id")
  defaultDeliveryBindingId String?  @map("default_delivery_binding_id")
  provider                 String?
  model                    String?
  status                   String   @default("active")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  metas                  AgentMeta[]
  channelBindings        AgentChannelBinding[]
  defaultDeliveryBinding AgentChannelBinding?  @relation("AgentDefaultDeliveryBinding", fields: [defaultDeliveryBindingId], references: [id], onDelete: SetNull)
  channelConversations   ChannelConversation[]
  sessions               Session[]
  memories               GlobalMemory[]
  tasks                  Task[]
  triggers               Trigger[]
  subAgentRunGroups      SubAgentRunGroup[]
  subAgentRuns           SubAgentRun[]
  sessionInboxEvents     SessionInboxEvent[]
  sessionWorkItems       SessionWorkItem[]

  @@map("agents")
}

model AgentMeta {
  agentId String @map("agent_id")
  key     String
  value   String

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, key])
  @@map("agent_meta")
}

model Channel {
  id         String    @id
  type       String
  name       String?
  tokenEnc   String?   @map("token_enc")
  botId      String?   @map("bot_id")
  userId     String?   @map("user_id")
  avatar     String?
  status     String    @default("unbound")
  lastActive DateTime? @map("last_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  legacyJson String?   @map("legacy_json")

  bindings       AgentChannelBinding[]
  routes         ChannelRoute[]
  conversations  ChannelConversation[]
  principals     ChannelPrincipal[]
  adminClaims    ChannelAdminClaim[]
  sourceTriggers Trigger[]             @relation("TriggerSourceChannel")

  @@index([type, status])
  @@map("channels")
}

model ChannelPrincipal {
  id             String   @id
  channelId      String   @map("channel_id")
  externalUserId String   @map("external_user_id")
  role           String   @default("system_admin")
  displayName    String?  @map("display_name")
  claimedAt      DateTime @default(now()) @map("claimed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalUserId])
  @@index([externalUserId])
  @@index([channelId, role])
  @@map("channel_principals")
}

model ChannelAdminClaim {
  id           String    @id
  channelId    String    @unique @map("channel_id")
  codeHash     String    @map("code_hash")
  expiresAt    DateTime  @map("expires_at")
  attemptCount Int       @default(0) @map("attempt_count")
  claimedAt    DateTime? @map("claimed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("channel_admin_claims")
}

model AgentChannelBinding {
  id               String   @id
  agentId          String   @map("agent_id")
  channelId        String   @map("channel_id")
  defaultSessionId String?  @map("default_session_id")
  enabled          Boolean  @default(true)
  inboundPolicy    String   @default("routed") @map("inbound_policy")
  outboundEnabled  Boolean  @default(true) @map("outbound_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  agent             Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  channel           Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  routes            ChannelRoute[]
  deliveryTasks     Task[]
  defaultForAgents  Agent[]            @relation("AgentDefaultDeliveryBinding")
  deliveryTriggers  Trigger[]          @relation("TriggerDeliveryBinding")
  subAgentRunGroups SubAgentRunGroup[]

  @@unique([agentId, channelId])
  @@index([channelId, enabled])
  @@map("agent_channel_bindings")
}

model ChannelRoute {
  id                     String   @id
  channelId              String   @map("channel_id")
  externalConversationId String   @map("external_conversation_id")
  bindingId              String   @map("binding_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  channel Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  binding AgentChannelBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalConversationId])
  @@index([bindingId])
  @@map("channel_routes")
}

model ChannelConversation {
  id                     String    @id
  channelId              String    @map("channel_id")
  agentId                String    @map("agent_id")
  conversationType       String    @map("conversation_type")
  externalConversationId String    @map("external_conversation_id")
  externalThreadId       String?   @map("external_thread_id")
  activeSessionId        String?   @map("active_session_id")
  lastActiveAt           DateTime? @map("last_active_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  channel       Channel                     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  agent         Agent                       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  activeSession Session?                    @relation("ActiveChannelSession", fields: [activeSessionId], references: [id], onDelete: SetNull)
  members       ChannelConversationMember[]
  sessions      ChannelSessionLink[]

  @@unique([channelId, agentId, externalConversationId])
  @@index([agentId, activeSessionId])
  @@map("channel_conversations")
}

model ChannelConversationMember {
  channelConversationId String    @map("channel_conversation_id")
  externalUserId        String    @map("external_user_id")
  displayName           String?   @map("display_name")
  role                  String?
  lastActiveAt          DateTime? @map("last_active_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  conversation ChannelConversation @relation(fields: [channelConversationId], references: [id], onDelete: Cascade)

  @@id([channelConversationId, externalUserId])
  @@index([externalUserId])
  @@map("channel_conversation_members")
}

model ChannelSessionLink {
  channelConversationId String   @map("channel_conversation_id")
  sessionId             String   @map("session_id")
  createdAt             DateTime @default(now()) @map("created_at")

  conversation ChannelConversation @relation(fields: [channelConversationId], references: [id], onDelete: Cascade)
  session      Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([channelConversationId, sessionId])
  @@index([sessionId])
  @@map("channel_session_links")
}

model Session {
  id              String    @id
  agentId         String    @map("agent_id")
  parentSessionId String?   @map("parent_session_id")
  kind            String    @default("conversation")
  title           String?
  visible         Boolean   @default(true)
  nextSeq         Int       @default(0) @map("next_seq")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  legacyMetadata  String?   @map("legacy_metadata")
  subagentKey     String?   @map("subagent_key")
  subagentRole    String?   @map("subagent_role")
  retentionPolicy String?   @map("retention_policy")
  lastRunAt       DateTime? @map("last_run_at")

  agent                      Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  parent                     Session?              @relation("SessionTree", fields: [parentSessionId], references: [id], onDelete: Cascade)
  children                   Session[]             @relation("SessionTree")
  messages                   Message[]
  crystals                   Crystal[]
  archives                   SessionArchive[]
  pendingMemories            PendingMemory[]
  activeChannelConversations ChannelConversation[] @relation("ActiveChannelSession")
  channelLinks               ChannelSessionLink[]
  tasks                      Task[]
  triggers                   Trigger[]
  subAgentRunGroups          SubAgentRunGroup[]    @relation("SubAgentRunGroupParentSession")
  subAgentRuns               SubAgentRun[]         @relation("SubAgentRunSession")
  parentedSubAgentRuns       SubAgentRun[]         @relation("SubAgentRunParentSession")
  sessionInboxEvents         SessionInboxEvent[]
  workItems                  SessionWorkItem[]
  workLease                  SessionWorkLease?

  @@unique([agentId, parentSessionId, subagentKey])
  @@index([agentId, updatedAt])
  @@index([parentSessionId])
  @@map("sessions")
}

model SubAgentRunGroup {
  id                String    @id
  agentId           String    @map("agent_id")
  parentSessionId   String    @map("parent_session_id")
  parentMessageId   String?   @map("parent_message_id")
  originType        String    @default("interactive") @map("origin_type")
  originTaskId      String?   @map("origin_task_id")
  originTriggerId   String?   @map("origin_trigger_id")
  status            String    @default("planning")
  completionPolicy  String    @default("all") @map("completion_policy")
  quorum            Int?
  deliveryBindingId String?   @map("delivery_binding_id")
  deliveryMode      String    @default("default") @map("delivery_mode")
  // Completion automatically wakes the parent Agent. The wake only carries
  // group/run identifiers; the parent reads persisted results via the tool.
  resumeParent      Boolean   @default(true) @map("resume_parent")
  contextVersion    Int?      @map("context_version")
  budgetJson        String    @default("{}") @map("budget_json")
  resultSummaryJson String?   @map("result_summary_json")
  idempotencyKey    String?   @map("idempotency_key")
  deadlineAt        DateTime? @map("deadline_at")
  revision          Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  finishedAt        DateTime? @map("finished_at")

  agent           Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deliveryBinding AgentChannelBinding? @relation(fields: [deliveryBindingId], references: [id], onDelete: SetNull)
  parentSession   Session              @relation("SubAgentRunGroupParentSession", fields: [parentSessionId], references: [id], onDelete: Cascade)
  runs            SubAgentRun[]

  @@unique([agentId, idempotencyKey])
  @@index([parentSessionId, createdAt])
  @@index([deliveryBindingId])
  @@index([agentId, status])
  @@map("subagent_run_groups")
}

model SubAgentRun {
  id                  String    @id
  groupId             String    @map("group_id")
  agentId             String    @map("agent_id")
  sessionId           String    @map("session_id")
  parentSessionId     String    @map("parent_session_id")
  revisionOfRunId     String?   @map("revision_of_run_id")
  jobKey              String    @map("job_key")
  taskType            String    @default("research") @map("task_type")
  objective           String
  inputJson           String    @default("{}") @map("input_json")
  outputContractJson  String    @default("{}") @map("output_contract_json")
  status              String    @default("queued")
  reviewStatus        String    @default("not_required") @map("review_status")
  resultJson          String?   @map("result_json")
  resultText          String?   @map("result_text")
  errorJson           String?   @map("error_json")
  toolNamesJson       String    @default("[]") @map("tool_names_json")
  toolDefinitionsHash String?   @map("tool_definitions_hash")
  provider            String?
  model               String?
  reasoningEffort     Int?      @map("reasoning_effort")
  budgetJson          String    @default("{}") @map("budget_json")
  attempt             Int       @default(1)
  leaseOwner          String?   @map("lease_owner")
  leaseExpiresAt      DateTime? @map("lease_expires_at")
  heartbeatAt         DateTime? @map("heartbeat_at")
  cancelRequestedAt   DateTime? @map("cancel_requested_at")
  cancelReason        String?   @map("cancel_reason")
  startedAt           DateTime? @map("started_at")
  finishedAt          DateTime? @map("finished_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  group         SubAgentRunGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  agent         Agent                   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  session       Session                 @relation("SubAgentRunSession", fields: [sessionId], references: [id], onDelete: Cascade)
  parentSession Session                 @relation("SubAgentRunParentSession", fields: [parentSessionId], references: [id], onDelete: Cascade)
  revisionOf    SubAgentRun?            @relation("SubAgentRunRevision", fields: [revisionOfRunId], references: [id], onDelete: SetNull)
  revisions     SubAgentRun[]           @relation("SubAgentRunRevision")
  dependencies  SubAgentRunDependency[] @relation("RunDependencies")
  dependents    SubAgentRunDependency[] @relation("DependsOnRun")
  events        SubAgentEvent[]
  artifacts     SubAgentArtifact[]

  @@unique([groupId, jobKey, attempt])
  @@index([groupId, status])
  @@index([sessionId, createdAt])
  @@index([parentSessionId, createdAt])
  @@index([status, leaseExpiresAt])
  @@map("subagent_runs")
}

model SubAgentRunDependency {
  runId          String @map("run_id")
  dependsOnRunId String @map("depends_on_run_id")
  condition      String @default("success")

  run       SubAgentRun @relation("RunDependencies", fields: [runId], references: [id], onDelete: Cascade)
  dependsOn SubAgentRun @relation("DependsOnRun", fields: [dependsOnRunId], references: [id], onDelete: Cascade)

  @@id([runId, dependsOnRunId])
  @@index([dependsOnRunId])
  @@map("subagent_run_dependencies")
}

model SubAgentEvent {
  id          String   @id
  runId       String   @map("run_id")
  type        String
  payloadJson String   @default("{}") @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at")

  run SubAgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@map("subagent_events")
}

model SubAgentArtifact {
  id        String   @id
  runId     String   @map("run_id")
  type      String
  name      String
  uri       String?
  path      String?
  mimeType  String?  @map("mime_type")
  size      Int?
  hash      String?
  createdAt DateTime @default(now()) @map("created_at")

  run SubAgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@map("subagent_artifacts")
}

// Legacy compatibility table. SubAgent results are no longer delivered through
// this Inbox; keep the table until a deliberate schema cleanup/migration.
model SessionInboxEvent {
  id                String    @id
  agentId           String    @map("agent_id")
  sessionId         String    @map("session_id")
  type              String
  payloadJson       String    @map("payload_json")
  status            String    @default("pending")
  availableAt       DateTime  @default(now()) @map("available_at")
  claimedAt         DateTime? @map("claimed_at")
  consumedAt        DateTime? @map("consumed_at")
  consumedMessageId String?   @map("consumed_message_id")
  attempts          Int       @default(0)
  lastError         String?   @map("last_error")
  idempotencyKey    String    @unique @map("idempotency_key")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status, availableAt])
  @@index([agentId, status])
  @@map("session_inbox_events")
}

// Durable ChatEvent delivery record for work that targets an Agent Session.
// Source-specific execution records remain separate and link through this row.
model SessionWorkItem {
  id                         String    @id
  eventId                    String    @unique @map("event_id")
  agentId                    String    @map("agent_id")
  sessionId                  String    @map("session_id")
  conversationKey            String    @map("conversation_key")
  kind                       String
  wakeKind                   String    @map("wake_kind")
  originRef                  String?   @map("origin_ref")
  idempotencyKey             String    @map("idempotency_key")
  instruction                String
  deliveryMode               String    @default("default") @map("delivery_mode")
  deliveryBindingId          String?   @map("delivery_binding_id")
  principalJson              String?   @map("principal_json")
  status                     String    @default("accepted")
  absorbedByEventId          String?   @map("absorbed_by_event_id")
  absorbedAssistantMessageId String?   @map("absorbed_assistant_message_id")
  completionJson             String?   @map("completion_json")
  lastError                  String?   @map("last_error")
  attempts                   Int       @default(0)
  availableAt                DateTime  @default(now()) @map("available_at")
  claimedAt                  DateTime? @map("claimed_at")
  startedAt                  DateTime? @map("started_at")
  finishedAt                 DateTime? @map("finished_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  agent             Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  session           Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([agentId, sessionId, idempotencyKey])
  @@index([sessionId, status, availableAt])
  @@index([agentId, status])
  @@index([originRef])
  @@map("session_work_items")
}

// Per-Session write/execution lease. fencingToken increases on each takeover;
// holders must verify both owner and token before committing protected writes.
model SessionWorkLease {
  sessionId      String   @id @map("session_id")
  leaseOwner     String   @map("lease_owner")
  fencingToken   Int      @default(1) @map("fencing_token")
  leaseExpiresAt DateTime @map("lease_expires_at")
  heartbeatAt    DateTime @default(now()) @map("heartbeat_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([leaseExpiresAt])
  @@map("session_work_leases")
}

model Message {
  id                     String    @id
  sessionId              String    @map("session_id")
  seq                    Int
  role                   String
  status                 String    @default("final")
  revision               Int       @default(0)
  text                   String?
  content                String
  fromUserId             String?   @map("from_user_id")
  sourceType             String?   @map("source_type")
  channelId              String?   @map("channel_id")
  externalConversationId String?   @map("external_conversation_id")
  externalMessageId      String?   @map("external_message_id")
  metadata               String?
  businessTime           DateTime? @map("business_time")
  archivedAt             DateTime? @map("archived_at")
  archiveId              String?   @map("archive_id")
  legacySource           String?   @unique @map("legacy_source")
  legacyJson             String?   @map("legacy_json")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  session   Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  archive   SessionArchive? @relation(fields: [archiveId], references: [id], onDelete: SetNull)
  toolCalls ToolCall[]
  chunks    MessageChunk[]

  @@unique([sessionId, seq])
  @@unique([channelId, externalMessageId])
  @@index([sessionId, status])
  @@index([sessionId, archivedAt, seq])
  @@index([sessionId, businessTime])
  @@index([channelId, externalConversationId])
  @@map("messages")
}

model SessionArchive {
  id             String   @id
  sessionId      String   @map("session_id")
  sourcePath     String   @unique @map("source_path")
  sourceHash     String   @map("source_hash")
  archivedAt     DateTime @map("archived_at")
  legacyMetadata String?  @map("legacy_metadata")
  createdAt      DateTime @default(now()) @map("created_at")

  session  Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([sessionId, archivedAt])
  @@map("session_archives")
}

model MessageChunk {
  id        String   @id
  messageId String   @map("message_id")
  seq       Int
  kind      String
  payload   String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, seq])
  @@index([messageId, createdAt])
  @@map("message_chunks")
}

model ToolCall {
  id         String   @id
  messageId  String   @map("message_id")
  seq        Int
  toolName   String   @map("tool_name")
  argsJson   String   @map("args_json")
  resultJson String?  @map("result_json")
  status     String   @default("running")
  durationMs Int?     @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, seq])
  @@index([toolName, createdAt])
  @@map("tool_calls")
}

model Crystal {
  id               String   @id
  sessionId        String   @map("session_id")
  content          String
  source           String   @default("auto")
  coversThroughSeq Int?     @map("covers_through_seq")
  createdAt        DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("crystals")
}

model PendingMemory {
  id        String   @id
  sessionId String   @map("session_id")
  seq       Int
  payload   String
  createdAt DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
  @@index([sessionId, createdAt])
  @@map("pending_memories")
}

// One row preserves one complete global/<category>.md document.
model GlobalMemory {
  id         String   @id
  agentId    String   @map("agent_id")
  category   String
  content    String
  sourceHash String?  @map("source_hash")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, category])
  @@index([agentId, category, updatedAt])
  @@map("global_memories")
}

model Trigger {
  id                String    @id
  agentId           String    @map("agent_id")
  sessionId         String    @map("session_id")
  deliveryBindingId String?   @map("delivery_binding_id")
  deliveryMode      String    @default("default") @map("delivery_mode")
  sourceChannelId   String?   @map("source_channel_id")
  type              String
  mode              String    @default("persistent")
  cronExpr          String?   @map("cron_expr")
  scriptPath        String?   @map("script_path")
  webhookSecretHash String?   @map("webhook_secret_hash")
  promptTemplate    String    @map("prompt_template")
  params            String?
  cooldownSec       Int       @default(1800) @map("cooldown_sec")
  maxFiresPerDay    Int       @default(5) @map("max_fires_per_day")
  enabled           Boolean   @default(true)
  lastFiredAt       DateTime? @map("last_fired_at")
  fireCount         Int       @default(0) @map("fire_count")
  wakeCount         Int       @default(0) @map("wake_count")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  legacyJson        String?   @map("legacy_json")

  agent           Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  session         Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  deliveryBinding AgentChannelBinding? @relation("TriggerDeliveryBinding", fields: [deliveryBindingId], references: [id], onDelete: SetNull)
  sourceChannel   Channel?             @relation("TriggerSourceChannel", fields: [sourceChannelId], references: [id], onDelete: SetNull)
  executions      TriggerExecution[]

  @@index([agentId, enabled, deletedAt])
  @@index([sessionId])
  @@index([deliveryBindingId])
  @@index([sourceChannelId])
  @@index([type, enabled])
  @@map("triggers")
}

model TriggerExecution {
  id                String    @id
  // Scalar audit link: adding a FK here would rebuild this populated SQLite table.
  sessionWorkItemId String?   @map("session_work_item_id")
  triggerId         String?   @map("trigger_id")
  triggerKey        String    @map("trigger_key")
  wake              Boolean
  reason            String?
  dataJson          String?   @map("data_json")
  sessionId         String?   @map("session_id")
  messageId         String?   @map("message_id")
  durationMs        Int?      @map("duration_ms")
  error             String?
  status            String    @default("ok")
  firedAt           DateTime? @map("fired_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  legacyJson        String?   @map("legacy_json")

  trigger         Trigger?         @relation(fields: [triggerId], references: [id], onDelete: Cascade)

  @@index([triggerKey, createdAt])
  @@index([status, createdAt])
  @@index([sessionWorkItemId])
  @@map("trigger_executions")
}

model LegacyMigration {
  id               String    @id
  sourcePath       String    @unique @map("source_path")
  sourceHash       String    @map("source_hash")
  sourceKind       String    @map("source_kind")
  sizeBytes        Int       @map("size_bytes")
  agentId          String?   @map("agent_id")
  sessionId        String?   @map("session_id")
  status           String    @default("pending")
  recordCount      Int       @default(0) @map("record_count")
  error            String?
  verificationJson String?   @map("verification_json")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([agentId, status])
  @@map("legacy_migrations")
}
